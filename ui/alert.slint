import { Theme } from "theme.slint";
import { Arrow, Line } from "shapes.slint";

// Data struct for a beacon positioned on the alert screen
export struct AlertBeacon {
    hex: string,
    callsign: string,
    screen-x: float,
    screen-y: float,
    rotation: float,
    is-new: bool,
}

// Data struct for flight detail info shown in the center
export struct AlertFlightDetail {
    callsign: string,
    origin-location: string,
    origin-name: string,
    destination-location: string,
    destination-name: string,
    has-route: bool,
    aircraft-type: string,
}

export component Alert inherits Rectangle {
    width: Theme.display-size;
    height: Theme.display-size;
    background: Theme.alert-bg;

    in property <[AlertBeacon]> beacons: [];
    in property <[AlertFlightDetail]> flight-details: [];
    // New flights this alert has picked up beyond the ones shown as cards
    in property <int> more-count: 0;

    callback dismiss();

    // Ring (static: continuous animation makes the software renderer redraw
    // the whole screen every frame, which pins a Pi Zero 2W's CPU)
    Rectangle {
        x: 32px;
        y: 32px;
        width: Theme.display-size - 64px;
        height: Theme.display-size - 64px;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: #ffffff26;
    }

    // Background lines (decorative, static for the same reason)
    for i in 4: Line {
        property <float> a: i * 45 + 22.5;
        x1: 240 - 240 * sin(self.a * 1deg);
        y1: 240 + 240 * cos(self.a * 1deg);
        x2: 240 + 240 * sin(self.a * 1deg);
        y2: 240 - 240 * cos(self.a * 1deg);
        stroke: #ffffff1a;
        stroke-width: 1px;
    }

    // Flight beacons
    for beacon[idx] in root.beacons: Rectangle {
        x: Theme.clock-center + beacon.screen-x * 1px - 10px;
        y: Theme.clock-center + beacon.screen-y * 1px - 10px;
        width: 20px;
        height: 20px;
        background: transparent;

        // Aircraft marker, pointing in towards the centre
        Arrow {
            x: 0;
            y: 0;
            size: 20px;
            angle: beacon.rotation + 180;
            color: Theme.beacon-color;
        }

        // Callsign label below beacon
        if beacon.callsign != "": Text {
            y: 22px;
            text: beacon.callsign;
            color: Theme.beacon-color;
            font-size: Theme.font-sm;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }

    // Flight detail cards in center
    VerticalLayout {
        alignment: center;
        padding-left: 60px;
        padding-right: 60px;
        spacing: 12px;

        for detail[idx] in root.flight-details: Rectangle {
            background: #ffffff1a;
            border-radius: 12px;
            height: detail.has-route ? 120px : 92px;
            min-width: 300px;

            VerticalLayout {
                alignment: center;
                padding: 12px;
                spacing: 8px;

                // Callsign
                Text {
                    text: detail.callsign;
                    color: Theme.fg;
                    font-size: Theme.font-3xl;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                // Route: origin -> destination
                if detail.has-route: HorizontalLayout {
                    alignment: center;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: detail.origin-location;
                            color: #ffffffcc;
                            font-size: Theme.font-xl;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: detail.origin-name;
                            color: Theme.fg-dim;
                            font-size: Theme.font-base;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    Text {
                        text: "\u{2192}";
                        color: #ffffffb3;
                        font-size: Theme.font-xl;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: detail.destination-location;
                            color: #ffffffcc;
                            font-size: Theme.font-xl;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: detail.destination-name;
                            color: Theme.fg-dim;
                            font-size: Theme.font-base;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                // No route found: show the aircraft type if we have it
                if !detail.has-route: Text {
                    text: detail.aircraft-type != "" ? "Aircraft: " + detail.aircraft-type : "Route information unavailable";
                    color: Theme.fg-dim;
                    font-size: Theme.font-base;
                    horizontal-alignment: center;
                }
            }
        }

        if root.more-count > 0: Text {
            text: "+\{root.more-count} more";
            color: Theme.fg-dim;
            font-size: Theme.font-base;
            horizontal-alignment: center;
        }
    }

    // Close button (top-right)
    Rectangle {
        x: Theme.display-size - 48px;
        y: 16px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: #ffffff1a;

        Text {
            text: "\u{00d7}";
            color: #ffffffb3;
            font-size: Theme.font-xl;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.dismiss(); }
        }
    }
}
