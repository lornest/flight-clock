import { Theme } from "theme.slint";
import { Line, Ring } from "shapes.slint";

// An aircraft on the alert screen. Absolute display coordinates.
export struct AlertBeacon {
    hex: string,
    callsign: string,
    x: float,
    y: float,
    // End of the heading line (same as x/y when the track is unknown)
    hx: float,
    hy: float,
    is-new: bool,
}

// Data struct for flight detail info shown in the center
export struct AlertFlightDetail {
    callsign: string,
    origin-location: string,
    origin-name: string,
    destination-location: string,
    destination-name: string,
    has-route: bool,
    aircraft-type: string,
}

// New-flight alert, styled to match the radar: aircraft around the edge,
// route cards in the middle. New aircraft are drawn in the accent colour.
export component Alert inherits Rectangle {
    width: Theme.display-size;
    height: Theme.display-size;
    background: Theme.bg;

    in property <[AlertBeacon]> beacons: [];
    in property <[AlertFlightDetail]> flight-details: [];
    // New flights this alert has picked up beyond the ones shown as cards
    in property <int> more-count: 0;

    callback dismiss();

    // Scope (static)
    Ring { r: 236px; border-width: 2px; border-color: Theme.accent-soft; }
    Ring { r: 210px; border-color: Theme.grid; }
    Ring { r: 140px; border-color: Theme.grid-faint; }
    Line { x1: 240; y1: 30; x2: 240; y2: 450; stroke: Theme.grid-faint; stroke-width: 1px; }
    Line { x1: 30; y1: 240; x2: 450; y2: 240; stroke: Theme.grid-faint; stroke-width: 1px; }

    // Aircraft
    for b in root.beacons: Rectangle {
        if b.hx != b.x || b.hy != b.y: Line {
            x1: b.x;
            y1: b.y;
            x2: b.hx;
            y2: b.hy;
            stroke: b.is-new ? Theme.accent : Theme.fg-soft;
            stroke-width: 1.5px;
        }
        Rectangle {
            x: (b.x - 5) * 1px;
            y: (b.y - 5) * 1px;
            width: 10px;
            height: 10px;
            background: b.is-new ? Theme.accent : Theme.fg-soft;
        }
        if b.callsign != "": Text {
            x: (b.x - 60) * 1px;
            y: (b.y + 9) * 1px;
            width: 120px;
            text: b.callsign;
            font-family: Theme.font-mono;
            font-size: 10.5px;
            font-weight: 500;
            color: b.is-new ? Theme.accent : Theme.fg-dim;
            horizontal-alignment: center;
        }
    }

    // Heading + flight cards
    VerticalLayout {
        alignment: center;
        padding-left: 64px;
        padding-right: 64px;
        spacing: 10px;

        for detail in root.flight-details: Rectangle {
            background: Theme.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.line;
            min-width: 300px;
            height: detail.has-route ? 128px : 92px;

            VerticalLayout {
                alignment: center;
                padding: 12px;
                spacing: 6px;

                Text {
                    text: detail.callsign;
                    font-family: Theme.font-display;
                    font-size: 34px;
                    font-weight: 600;
                    letter-spacing: -0.5px;
                    color: Theme.fg;
                    horizontal-alignment: center;
                }

                if detail.has-route: HorizontalLayout {
                    alignment: center;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: detail.origin-location;
                            font-family: Theme.font-display;
                            font-size: Theme.font-lg;
                            font-weight: 500;
                            color: Theme.fg;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: detail.origin-name;
                            font-family: Theme.font-mono;
                            font-size: 14px;
                            color: Theme.fg-dim;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    Text {
                        text: "→";
                        font-family: Theme.font-mono;
                        font-size: Theme.font-lg;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: detail.destination-location;
                            font-family: Theme.font-display;
                            font-size: Theme.font-lg;
                            font-weight: 500;
                            color: Theme.fg;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: detail.destination-name;
                            font-family: Theme.font-mono;
                            font-size: 14px;
                            color: Theme.fg-dim;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                // No route found: show the aircraft type if we have it
                if !detail.has-route: Text {
                    text: detail.aircraft-type != "" ? "AIRCRAFT · " + detail.aircraft-type : "ROUTE UNAVAILABLE";
                    font-family: Theme.font-mono;
                    font-size: 12px;
                    letter-spacing: 1.5px;
                    color: Theme.fg-dim;
                    horizontal-alignment: center;
                }
            }
        }

        if root.more-count > 0: Text {
            text: "+\{root.more-count} MORE";
            font-family: Theme.font-mono;
            font-size: 11px;
            letter-spacing: 2px;
            color: Theme.fg-dim;
            horizontal-alignment: center;
        }
    }

    // Close button (top-right, inside the round display)
    Rectangle {
        x: 352px;
        y: 72px;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        border-width: 1px;
        border-color: Theme.line;
        background: close-touch.pressed ? Theme.surface : Theme.bg;

        Text {
            text: "×";
            font-family: Theme.font-display;
            color: Theme.fg-dim;
            font-size: Theme.font-xl;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        close-touch := TouchArea {
            clicked => { root.dismiss(); }
        }
    }
}
