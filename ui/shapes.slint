import { Theme } from "theme.slint";

// Shapes drawn with Path instead of `transform-rotation`.
// The software renderer used on the Pi (linuxkms-software) ignores
// transforms, so anything that needs to point in a direction is built from
// path coordinates computed from an angle.

// A straight line in display coordinates (0..480 on both axes).
// Place it at x: 0, y: 0 inside a full-display parent.
export component Line inherits Path {
    in property <float> x1;
    in property <float> y1;
    in property <float> x2;
    in property <float> y2;

    x: 0;
    y: 0;
    width: Theme.display-size;
    height: Theme.display-size;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 480;
    viewbox-height: 480;
    stroke-line-cap: round;

    MoveTo { x: root.x1; y: root.y1; }
    LineTo { x: root.x2; y: root.y2; }
}

// A line from the display centre outwards at `angle` degrees clockwise from
// 12 o'clock. Used for clock hands.
export component Spoke inherits Line {
    in property <float> angle;
    in property <float> length;

    x1: 240;
    y1: 240;
    x2: 240 + root.length * sin(root.angle * 1deg);
    y2: 240 - root.length * cos(root.angle * 1deg);
}

// A filled triangle pointing `angle` degrees clockwise from up, centred in a
// `size` x `size` box. Used for aircraft markers.
export component Arrow inherits Path {
    in property <float> angle;
    in property <length> size: 20px;
    in property <color> color: Theme.fg;

    width: root.size;
    height: root.size;
    viewbox-x: -10;
    viewbox-y: -10;
    viewbox-width: 20;
    viewbox-height: 20;
    fill: root.color;

    MoveTo {
        x: 9 * sin(root.angle * 1deg);
        y: -9 * cos(root.angle * 1deg);
    }
    LineTo {
        x: 8 * sin((root.angle + 140) * 1deg);
        y: -8 * cos((root.angle + 140) * 1deg);
    }
    LineTo {
        x: 8 * sin((root.angle + 220) * 1deg);
        y: -8 * cos((root.angle + 220) * 1deg);
    }
    Close { }
}
