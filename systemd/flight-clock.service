[Unit]
Description=FlightClock Display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/flight-clock
ExecStart=/opt/flight-clock/flight-clock
Restart=always
RestartSec=5
WatchdogSec=120
NotifyAccess=main
StandardOutput=journal
StandardError=journal
MemoryMax=128M

# --- Sandbox ---
# This process is root (it drives the display, WiFi and updates) and it reads
# flight data from the internet, so it gets only what that work needs. The
# programs it runs (nmcli, systemctl, hostapd...) inherit the same limits.
#
# Deliberately NOT set, because each would take the display or touch away:
#   PrivateDevices, DeviceAllow/DevicePolicy, and ProtectClock (which implies
#   a DeviceAllow list): the app opens /dev/dri and /dev/input directly.
#   ProtectKernelTunables: night mode switches the backlight through /sys.
# src/update.rs has a test that fails if one of those is added.
NoNewPrivileges=yes
# /usr, /boot and /etc read-only, apart from the settings and the WiFi setup
# files ("-": fine if the folder doesn't exist on this system)
ProtectSystem=full
ReadWritePaths=/etc/flight-clock
ReadWritePaths=-/etc/NetworkManager/dnsmasq-shared.d
ReadWritePaths=-/etc/wpa_supplicant
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Unix sockets (systemd, NetworkManager), the internet, and what WiFi and
# input device handling use
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
# No mounting, module loading, rebooting, clock setting, raw I/O or debugging
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Root, but without the powers this never uses (no CAP_SYS_ADMIN,
# CAP_SYS_MODULE, CAP_SYS_PTRACE, CAP_SYS_BOOT...). Kept: file ownership and
# access (the web server's socket), signals, network setup, and dropping
# privileges (dnsmasq, for the hotspot on systems without NetworkManager).
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_SETUID CAP_SETGID CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

# Slint LinuxKMS backend with software renderer (no GPU/X11/Wayland needed)
Environment=SLINT_BACKEND=linuxkms-software

# Ensure libinput can find devices for touch input
Environment=XDG_RUNTIME_DIR=/run/user/0

[Install]
WantedBy=multi-user.target
