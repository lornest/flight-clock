import { Theme } from "theme.slint";
import { Arrow } from "shapes.slint";

// Data struct for a beacon on the radar
export struct RadarBeacon {
    hex: string,
    callsign: string,
    screen-x: float,
    screen-y: float,
    rotation: float,
    distance-nm: float,
    altitude: string,
    speed: string,
}

export component Radar inherits Rectangle {
    width: Theme.display-size;
    height: Theme.display-size;
    background: Theme.bg;
    border-width: 2px;
    border-color: #ffffff33;
    border-radius: Theme.display-radius;

    in property <[RadarBeacon]> beacons: [];
    in property <string> facing-direction: "N";
    in property <int> flight-count: 0;
    in property <bool> updating: false;
    // Last fetch error; empty when the last fetch worked
    in property <string> error-text: "";

    callback background-tapped(float, float);  // x, y relative to center

    // Tap handler for background (dismiss detail / navigate)
    bg-touch := TouchArea {
        clicked => {
            root.background-tapped(
                (self.mouse-x - root.width / 2) / 1px,
                (self.mouse-y - root.height / 2) / 1px
            );
        }
    }

    // Distance rings at 20%, 40%, 60%, 80%, 100% of max radius
    for i in 5: Rectangle {
        property <length> ring-radius: (i + 1) * Theme.radar-max-radius / 5;
        x: Theme.clock-center - self.ring-radius;
        y: Theme.clock-center - self.ring-radius;
        width: self.ring-radius * 2;
        height: self.ring-radius * 2;
        border-radius: self.ring-radius;
        border-width: 1px;
        border-color: #ffffff33;
        background: transparent;
    }

    // Center dot
    Rectangle {
        x: Theme.clock-center - 3px;
        y: Theme.clock-center - 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.fg;
    }

    // Facing direction indicator (top center)
    Rectangle {
        x: Theme.clock-center - 50px;
        y: 12px;
        width: 100px;
        height: 40px;
        border-radius: 8px;
        background: #3b82f6cc;
        border-width: 1px;
        border-color: #ffffff33;

        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            padding: 4px;

            Text {
                text: "\u{2191}";
                color: Theme.fg;
                font-size: Theme.font-lg;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: root.facing-direction;
                color: Theme.fg;
                font-size: Theme.font-lg;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    // Flight beacons
    for beacon[idx] in root.beacons: Rectangle {
        x: Theme.clock-center + beacon.screen-x * 1px - 70px;
        y: Theme.clock-center + beacon.screen-y * 1px - 28px;
        width: 140px;
        height: 56px;
        background: transparent;
        clip: false;

        // Callsign - centered above diamond
        if beacon.callsign != "": Text {
            x: 0px;
            y: 0px;
            width: 140px;
            height: 16px;
            text: beacon.callsign;
            color: Theme.fg;
            font-size: Theme.font-xs;
            font-weight: 700;
            horizontal-alignment: center;
        }

        // Altitude - left of diamond, right-aligned
        Text {
            x: 0px;
            y: 20px;
            width: 53px;
            height: 16px;
            text: beacon.altitude;
            color: Theme.fg-dim;
            font-size: Theme.font-xs;
            horizontal-alignment: right;
        }

        // Aircraft marker, pointing in towards the centre (as the old app did)
        Arrow {
            x: 60px;
            y: 18px;
            size: 20px;
            angle: beacon.rotation + 180;
            color: Theme.fg;
        }

        // Speed - right of diamond, left-aligned
        Text {
            x: 87px;
            y: 20px;
            width: 53px;
            height: 16px;
            text: beacon.speed;
            color: Theme.fg-dim;
            font-size: Theme.font-xs;
            horizontal-alignment: left;
        }

        // Distance - centered below diamond
        Text {
            x: 0px;
            y: 40px;
            width: 140px;
            height: 16px;
            text: "\{round(beacon.distance-nm * 10) / 10}nm";
            color: Theme.fg-dim;
            font-size: Theme.font-xs;
            horizontal-alignment: center;
        }
    }

    // Fetch in progress
    if root.updating: Text {
        y: 58px;
        width: parent.width;
        text: "Updating...";
        color: Theme.fg-dim;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
    }

    // Fetch failed
    if root.error-text != "": Rectangle {
        x: Theme.clock-center - 140px;
        y: Theme.display-size - 92px;
        width: 280px;
        height: 60px;
        border-radius: 16px;
        background: #7f1d1dcc;
        border-width: 1px;
        border-color: #f8717180;

        VerticalLayout {
            alignment: center;
            padding-left: 12px;
            padding-right: 12px;
            Text {
                text: "Connection error";
                color: #fecaca;
                font-size: Theme.font-base;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: root.error-text;
                color: #fecacacc;
                font-size: Theme.font-sm;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }

    // "Clear skies" message when no flights
    if root.flight-count == 0 && root.error-text == "": Rectangle {
        x: Theme.clock-center - 80px;
        y: Theme.display-size - 60px;
        width: 160px;
        height: 40px;
        border-radius: 20px;
        background: #ffffff1a;

        Text {
            text: "Clear skies";
            color: #ffffffe6;
            font-size: Theme.font-lg;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
