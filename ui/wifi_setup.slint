import { Theme } from "theme.slint";
import { Ring } from "shapes.slint";

export component WifiSetup inherits Rectangle {
    width: Theme.display-size;
    height: Theme.display-size;
    background: Theme.bg;

    in property <string> status-text: "Setting up WiFi...";
    in property <bool> status-is-error: false;
    in property <bool> can-cancel: false;
    in property <string> ssid: "FlightClock-Setup";
    in property <string> portal-address: "192.168.4.1";

    callback cancel();

    Ring { r: 236px; border-width: 2px; border-color: Theme.line; }
    Ring { r: 200px; border-color: Theme.grid-faint; }

    // Content is kept inside the round display's safe area.
    VerticalLayout {
        alignment: center;
        padding-left: 72px;
        padding-right: 72px;
        spacing: 12px;

        Text {
            text: "WIFI SETUP";
            font-family: Theme.font-mono;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 3px;
            color: Theme.accent;
            horizontal-alignment: center;
        }

        Text {
            text: "On your phone, join";
            font-family: Theme.font-display;
            font-size: Theme.font-lg;
            font-weight: 500;
            color: Theme.fg;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 48px;
            border-radius: 24px;
            border-width: 1px;
            border-color: Theme.accent;
            background: Theme.surface;
            Text {
                text: root.ssid;
                font-family: Theme.font-mono;
                font-size: Theme.font-lg;
                font-weight: 500;
                color: Theme.accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: "The setup page should open by itself.\nIf not, go to " + root.portal-address;
            font-family: Theme.font-mono;
            font-size: 12px;
            color: Theme.fg-dim;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: root.status-text;
            font-family: Theme.font-mono;
            font-size: 12px;
            font-weight: root.status-is-error ? 500 : 400;
            color: root.status-is-error ? Theme.error : Theme.fg-faint;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.can-cancel: HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 200px;
                height: 44px;
                border-radius: 22px;
                border-width: 1px;
                border-color: Theme.line;
                background: cancel-touch.pressed ? Theme.surface : Theme.bg;
                Text {
                    text: "USE SAVED WIFI";
                    font-family: Theme.font-mono;
                    font-size: 12px;
                    font-weight: 500;
                    letter-spacing: 1.5px;
                    color: Theme.fg-soft;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                cancel-touch := TouchArea {
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}
